# Local preview output only. The published pages live in docs/, which IS
# committed — that is what GitHub serves.
_site/
_site_test/
.jekyll-cache/
.jekyll-metadata

# Local gem install. Kept in a dot-folder so Obsidian ignores it — the gems
# contain ~166 of their own .md files, which would otherwise bury the 10
# pages of this site in Obsidian's sidebar and search.
.vendor/
vendor/
.bundle/

# macOS
.DS_Store

# Obsidian: keep the settings that make writing here work (app.json),
# drop the per-machine window layout and caches.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.obsidian/graph.json

# Record of each time the publish button was pressed. Local only.
publish.log
