source "https://rubygems.org"

# Only needed to preview the site on your own computer. GitHub builds the
# published site itself from this same file (see .github/workflows/pages.yml).
gem "jekyll", "~> 4.4"

# Lets you link between pages the way Obsidian writes them — [Safety](safety.md)
# — and turns them into working web links when the site is built.
gem "jekyll-relative-links"
