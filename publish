#!/bin/sh
#
# Puts your changes on the live site, from a Terminal.
#
#   ./publish "added the safety section"
#
# TO PUBLISH BY HAND, DOUBLE-CLICK "Publish.command" INSTEAD.
#
# This file is for typing a command. Double-clicking it used to open a
# Terminal, print a usage note and quit without publishing anything — which
# looked exactly like the button being broken. It no longer does that: with
# no message given it hands over to Publish.command, so whichever of the two
# you click, your work gets published.
#
# The message in quotes is a note to your future self about what changed.
# It shows up in the history so you can find or undo things later.

set -e
cd "$(dirname "$0")"

message="$1"

# Double-clicked, or run with no message: use the button's dialog instead of
# failing. Nobody should lose work to picking the wrong one of two files.
if [ -z "$message" ]; then
  if [ -x "./Publish.command" ]; then
    exec "./Publish.command"
  fi
  echo "Say what changed, in quotes. For example:"
  echo "  ./publish \"wrote the first half of the Safety page\""
  exit 1
fi

if [ -z "$(git status --porcelain)" ]; then
  echo "Nothing has changed since the last publish — nothing to do."
  exit 0
fi

echo "About to publish these files:"
echo
git -c color.status=always status --short
echo

# The site is public, so give a heads-up if something reads unfinished.
if grep -lE "Placeholder text|Tagline goes here|^site_title: Title$" ./*.md 2>/dev/null | grep -v README.md | grep -q .; then
  echo "Heads up: some pages still have placeholder text on them."
  echo "That's fine if it's deliberate — the site is public, so it will be visible."
  echo
fi

# Notes-to-self that would be published as visible text. Deliberately narrow:
# [Source], [Definition], [anything source], [Link to ...] and {any note}.
# Real markdown links end in "](", and footnotes start with [^, so neither
# is matched here.
# Only the page files themselves — not the guide, and not anything inside
# the gem folder, which is full of markdown that looks similar.
# Matches: [Source], [Definition], [Link to ...], [any ... source ...],
# a bare URL in square brackets, and {a note in curly braces}.
# The trailing "\(?" lets the next filter drop real markdown links, whose
# closing bracket is followed by "(" — so [read the source](url) is safe.
notes=$(grep -noE "\[[^]^(]*([Ss]ource|Definition|Link to)[^](]*\]\(?|\[https?://[^]]*\]|\{[^}]{2,}\}" ./*.md 2>/dev/null \
  | grep -v "README.md" \
  | grep -vE '\($' \
  | sed 's|^\./||')

if [ -n "$notes" ]; then
  count=$(printf '%s\n' "$notes" | wc -l | tr -d ' ')
  echo "Heads up: $count unfinished note(s) would be published as visible text:"
  echo
  printf '%s\n' "$notes" | sed 's/^/  /'
  echo
  echo "These show up on the public page exactly as written, brackets and all."
  echo
fi

printf "Publish? [y/N] "
read -r reply
case "$reply" in
  [yY]*) ;;
  *) echo "Cancelled. Nothing was published."; exit 0 ;;
esac

# Build here rather than on GitHub — docs/ is committed and served directly.
if [ -d /opt/homebrew/opt/ruby/bin ]; then
  PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  export PATH
fi

echo "Building the site..."
if ! bundle exec jekyll build; then
  echo "Build failed. Nothing was published."
  exit 1
fi

git add -A
git commit -q -m "$message"
git push -q origin main

echo
echo "Published. The site updates in about a minute:"
echo "  https://jonesy37.github.io/phil4830-site/"
echo
echo "To watch the progress:  gh run watch"
